# Copy this file to .env locally. Never commit the copied file.

# DATA_ROOT=F:\Predictive agents\Data
# RESOURCE_ROOT=F:\Predictive agents\Resources
# LOG_LEVEL=INFO
# RANDOM_SEED=42

# Add API keys only to the local .env file:
# PAPER_API_KEY=
# MODEL_API_KEY=
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# GITHUB_TOKEN=your_github_token_here
# CROSSREF_MAILTO=your_real_email@example.com  # CrossRef polite pool (free, no key needed)

# Huawei Cloud OBS credentials (only needed if configs/cloud_storage.yaml
# huawei_obs.enabled is true). Create an Access Key pair in the Huawei
# Cloud console under "My Credentials" and paste it here locally.
# HUAWEICLOUD_AK=your_access_key_id_here
# HUAWEICLOUD_SK=your_secret_access_key_here
